{
    "manifest_version": 2,
    "name": "zotLook",
    "version": "1.4.1",
    "description": "Preview attachments by pressing Space, through the system's own preview panel",
    "homepage_url": "https://github.com/fre-ms/zotLook",
    "author": "fre.ms and Guillaume Chapron",
    "icons": {
        "32": "icon/zotlook-32.svg",
        "48": "icon/zotlook-48.svg",
        "96": "icon/zotlook-96.svg"
    },
    "applications": {
        "zotero": {
            "id": "zotlook@fre.ms",
            "update_url": "https://zotlook.org/update.json",
            "strict_min_version": "6.999",
            "strict_max_version": "10.*"
        }
    }
}
