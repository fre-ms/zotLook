.DS_Store
build/
addon/qlpreview
# Written by build.sh, packaged, never committed
addon/build.txt
node_modules/

# Per-language copies of doc/_theme and ../asset, recreated by doc/build.sh
# on every run. Named one by one rather than globbed: doc/*/ would also match
# doc/_theme/ and leave the vendored theme itself out of the repository.
doc/en/_extensions/
doc/de/_extensions/
doc/en/font/
doc/de/font/
doc/en/asset/
doc/de/asset/
doc/en/theme/
doc/de/theme/
doc/en/.quarto/
doc/de/.quarto/
doc/.quarto/

# The built site; published from CI, never committed
site/

# Deleting a tracked file through the macOS Finder leaves a zero-byte
# tombstone beside it that its owner may not remove. It is not ours and it
# must never be committed.
*.gitFinderDeleted
